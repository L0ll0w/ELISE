  - nodeID: 1
    characterName: Gardener
    portrait: {fileID: 21300000, guid: 1a789862d9bab7143ad995f8c71e3242, type: 3}
    portraitPrefab: {fileID: 2171618739374429775, guid: 4df3bf5dd6f18d14aa9d470a3c7d8aab, type: 3}
    portraitAnimator: {fileID: 9100000, guid: 3c74c7bb9694b2349980a0ebc05b6a73, type: 2}
    sentence: "Il cherche cette melodie sans cesse jour et nuit depuis une eternit\xE9."
    choices: []
    nextNodeID: 2
  - nodeID: 2
    characterName: Gardener
    portrait: {fileID: 0}
    portraitPrefab: {fileID: 0}
    portraitAnimator: {fileID: 0}
    sentence: "Je me rappelle de notre premiere journ\xE9 de bonheur ensemble, il
      ete mon seul ami..."
    choices: []
    nextNodeID: 3
  - nodeID: 3
    characterName: Gardener
    portrait: {fileID: 0}
    portraitPrefab: {fileID: 0}
    portraitAnimator: {fileID: 0}
    sentence: "J'avais pris ma camera pour filmer cette journ\xE9e, on avait fait
      plein de pose rigolote"
    choices: []
    nextNodeID: 4
  - nodeID: 4
    characterName: Gardener
    portrait: {fileID: 0}
    portraitPrefab: {fileID: 0}
    portraitAnimator: {fileID: 0}
    sentence: 'Je l''es filmer jouer au Ballon, pendant que je faisait du Ukulele '
    choices: []
    nextNodeID: 5
  - nodeID: 5
    characterName: Gardener
    portrait: {fileID: 0}
    portraitPrefab: {fileID: 0}
    portraitAnimator: {fileID: 0}
    sentence: Devoveo a meme gagner un tropher pour le coucour annuel de biboquet.
    choices: []
    nextNodeID: 6
  - nodeID: 6
    characterName: Gardener
    portrait: {fileID: 0}
    portraitPrefab: {fileID: 0}
    portraitAnimator: {fileID: 0}
    sentence: Alors la nuit venue, je rangeais ma camera, admirant une derniere fois
      le ballon
    choices: []
    nextNodeID: 7
  - nodeID: 7
    characterName: Gardener
    portrait: {fileID: 0}
    portraitPrefab: {fileID: 0}
    portraitAnimator: {fileID: 0}
    sentence: Qui nous avait apporter un peut de bonheur dans cette vie monotone...
    choices: []
    nextNodeID: 8
  - nodeID: 8
    characterName: Gardener
    portrait: {fileID: 0}
    portraitPrefab: {fileID: 0}
    portraitAnimator: {fileID: 0}
    sentence: 'Voila... tu sais tout. '
