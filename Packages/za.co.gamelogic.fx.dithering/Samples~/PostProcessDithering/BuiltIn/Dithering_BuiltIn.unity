--- !u!114 &1413275575
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1413275573}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f09c7de40bd1bec4e9665d48248bab18, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  text: "This is a test scene that works with the Built-in pipeline. (If you have
    another pipeline set up, all the textures will be magenta).\r\n\r\nYou enable/disable
    objects under the Effects GameObject in the hierarchy to play with different
    effects.\r\n\r\n\u26A0\uFE0F The Dither Texture Bias examples are best viewed
    at 1920\xD71080.\r\n\u26A0\uFE0F Disable the Pixelate Object when enabling the
    Dither Texture Bias or UV Mapped examples.\r\n\u26A0\uFE0F The Min filter is
    used to make dark lines thicker. Disable it if you disable the outline, or use
    the Max filter if you want to make a light outline thicker.\r\n\u26A0\uFE0F It
    is better not to have more than one tone map active.\r\n\u26A0\uFE0F It is not
    usual to have so many map renderers.\r\n\u26A0\uFE0F Blurring does not improve
    most dithering schemes, except the two \u201CMarks\u201D examples (switch off
    the outline and Min filter in that case).\r\n"
